meta {
  name: Search
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: apikey
}

auth:apikey {
  key: api_key
  value: {{apiKey}}
  placement: queryparams
}

body:graphql {
  query Search($q: String!) {
    products(q: $q) { id }
  }
}

body:graphql:vars {
  {
    "q": "{{term}}"
  }
}
