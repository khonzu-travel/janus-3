{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    // "DOM" types the web-standard APIs core may use (AbortSignal, fetch, URL, TextEncoder).
    // Browser-only globals (window, document, localStorage, ...) are banned in eslint.config.js.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"]
}
